{
  "name": "re-focus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:assets": "node scripts/prepare-theme-assets.mjs && node scripts/prepare-pwa-assets.mjs",
    "predev": "npm run prepare:assets",
    "dev": "next dev",
    "prebuild": "npm run prepare:assets",
    "build": "next build && node scripts/build-service-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "perf": "node scripts/measure-performance.mjs",
    "perf:interactions": "node scripts/measure-interactions.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "nanoid": "^3.3.19",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lighthouse": "13.5.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "workbox-build": "7.4.1"
  }
}
